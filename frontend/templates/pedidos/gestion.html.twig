{% extends 'base.html.twig' %}

{% block title %}Gestión de Pedidos - DonWok{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold m-0 text-dark">Cola de Producción</h2>
            <p class="text-muted mb-0">Gestión de estados en tiempo real</p>
        </div>
        <div id="sse-status-badge">
            <span class="badge bg-secondary px-3 py-2 rounded-pill">Iniciando SSE...</span>
        </div>
    </div>

    <div class="dw-card shadow-sm overflow-hidden border-0">
        <div class="p-3 border-bottom bg-white">
            <div class="input-group" style="max-width: 360px;">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-primary"></i></span>
                <input type="search" id="order-filter" class="form-control border-start-0" placeholder="Filtrar por número de orden..." inputmode="numeric" autocomplete="off">
                <button type="button" id="clear-order-filter" class="btn btn-outline-secondary d-none" title="Limpiar filtro"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted fw-bold small text-uppercase">Orden</th>
                        <th class="py-3 text-muted fw-bold small text-uppercase">Productos</th>
                        <th class="text-center py-3 text-muted fw-bold small text-uppercase">Tipo</th>
                        <th class="text-center py-3 text-muted fw-bold small text-uppercase">Pago</th>
                        <th class="text-center py-3 text-muted fw-bold small text-uppercase">Total</th>
                        <th class="text-center py-3 text-muted fw-bold small text-uppercase">Estado</th>
                        <th class="pe-4 text-end py-3 text-muted fw-bold small text-uppercase">Acción</th>
                    </tr>
                </thead>
                <tbody id="production-queue">
                    <tr><td colspan="5" class="text-center py-5 text-muted">Cargando cola...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Pago -->
<div class="modal fade" id="modalPago" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Finalizar Facturación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-5">
                    <small class="text-muted d-block mb-1 fw-bold text-uppercase" style="letter-spacing: 1px;">Total a Cobrar</small>
                    <h1 class="fw-extrabold text-primary m-0 display-4" id="pago-total-display">$0</h1>
                </div>
                
                <div id="payment-accounts" class="row g-4">
                    <div class="col-12 text-center text-muted py-3">Cargando cuentas configuradas...</div>
                </div>
                <div class="small text-muted mt-2"><i class="bi bi-info-circle me-1"></i> El saldo restante se asigna automáticamente a efectivo. Puedes repartir el pago entre las cuentas habilitadas desde Cajas.</div>

                    <div class="col-12" id="wrapper-recibido">
                        <hr class="my-2 opacity-10">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-primary text-uppercase">Efectivo Recibido (Cliente)</label>
                            <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden mb-3">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-person-down text-primary"></i></span>
                                <input type="number" id="input-recibido" class="form-control border-x-0 ps-0 fw-bold" step="100" placeholder="¿Cuánto dinero entregó el cliente?">
                                <button class="btn btn-outline-danger fw-bold px-3" type="button" id="btn-reset-recibido"><i class="bi bi-x-circle"></i></button>
                            </div>

                            <!-- Botones de Denominaciones Rápidas (Suman al total) -->
                            <div class="d-flex flex-wrap gap-2 justify-content-center mb-2">
                                {% for monto in [2000, 5000, 10000, 20000, 50000, 100000] %}
                                    <button type="button" class="btn btn-outline-primary btn-sm fw-bold px-3 py-2 rounded-3 quick-cash" data-value="{{ monto }}">
                                        {{ monto|number_format(0, ',', '.') }}
                                    </button>
                                {% endfor %}
                            </div>
                            <div class="d-flex flex-wrap gap-2 justify-content-center">
                                {% for monto in [50, 100, 200, 500, 1000] %}
                                    <button type="button" class="btn btn-outline-secondary btn-sm fw-bold rounded-pill quick-cash" style="font-size: 0.7rem;" data-value="{{ monto }}">
                                        {{ monto|number_format(0, ',', '.') }}
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                <div class="p-4 bg-primary-subtle rounded-4 text-center mt-4 d-none" id="container-cambio" style="border: 2px dashed var(--bs-primary);">
                    <small class="text-primary d-block fw-bold text-uppercase mb-1" style="letter-spacing: 1px;">Cambio a Devolver</small>
                    <h2 class="fw-bold text-dark m-0 display-5" id="display-cambio">$0</h2>
                </div>

                <div id="pago-error" class="alert alert-danger mt-3 py-3 fw-bold small d-none shadow-sm border-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> El valor de transferencia supera el total de la factura.
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <div class="form-check form-switch w-100 mb-3">
                    <input class="form-check-input" type="checkbox" id="imprimir-factura">
                    <label class="form-check-label small fw-bold" for="imprimir-factura">Imprimir factura después de facturar</label>
                </div>
                <button type="button" class="btn btn-primary w-100 py-3 fs-5 fw-bold shadow-lg" id="btn-confirmar-pago" style="border-radius: 15px;">
                    <i class="bi bi-check-circle-fill me-2"></i> CONFIRMAR Y FACTURAR
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script type="module">
    import CoreAPI from '/js/core.js';
    import MercureClient from '/js/mercure.js';
    const api = new CoreAPI();
    let selectedPedido = null;
    let pedidosEnCola = [];
    let filtroOrden = '';

    // Lógica de cálculos del modal
    const inputRecibido = document.getElementById('input-recibido');
    const containerCambio = document.getElementById('container-cambio');
    const displayCambio = document.getElementById('display-cambio');
    const errorPago = document.getElementById('pago-error');
    const wrapperRecibido = document.getElementById('wrapper-recibido');
    const orderFilter = document.getElementById('order-filter');
    const clearOrderFilter = document.getElementById('clear-order-filter');

    const fmt = (v) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(v);
    let cuentasFacturacion = [];

    async function cargarCuentasFacturacion() {
        cuentasFacturacion = await api.get('/caja/cuentas/facturacion');
        document.getElementById('payment-accounts').innerHTML = cuentasFacturacion.length ? cuentasFacturacion.map(c => `
            <div class="col-md-6">
                <label class="form-label small fw-bold text-secondary text-uppercase">${c.nombre}</label>
                <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                    <span class="input-group-text bg-white border-end-0"><i class="bi ${c.tipo === 'CAJA' ? 'bi-cash-stack text-success' : 'bi-phone text-info'}"></i></span>
                    <input type="number" min="0" step="0.01" value="0" ${c.tipo === 'CAJA' ? 'readonly' : ''} class="form-control border-start-0 ps-0 fw-bold payment-account-input" data-account-id="${c.id}" data-account-type="${c.tipo}">
                    <button class="btn ${c.tipo === 'CAJA' ? 'btn-success' : 'btn-info text-white'} fw-bold px-3 btn-account-todo" type="button" data-account-id="${c.id}">TODO</button>
                </div>
                <small class="text-muted mt-2 d-block">${c.tipo === 'CAJA' ? 'Efectivo a recibir.' : 'Pago digital.'}</small>
            </div>`).join('') : '<div class="col-12"><div class="alert alert-warning small">No hay cuentas configuradas para facturación. Activa una desde Cajas.</div></div>';
        document.querySelectorAll('.payment-account-input').forEach(input => input.addEventListener('input', () => actualizarPago(input)));
        document.querySelectorAll('.btn-account-todo').forEach(button => button.addEventListener('click', () => {
            document.querySelectorAll('.payment-account-input').forEach(input => input.value = '0');
            const input = document.querySelector(`.payment-account-input[data-account-id="${button.dataset.accountId}"]`);
            if (input) input.value = document.getElementById(`row-${selectedPedido}`)?.dataset.total || '0';
            actualizarPago();
        }));
    }

    function getDistribucion() {
        return [...document.querySelectorAll('.payment-account-input')].map(input => ({ cuenta_id: Number(input.dataset.accountId), monto: parseFloat(input.value) || 0, tipo: input.dataset.accountType })).filter(p => p.monto > 0);
    }

    function montoCaja() { return getDistribucion().filter(p => p.tipo === 'CAJA').reduce((sum, p) => sum + p.monto, 0); }

    function updateOrderFilter() {
        filtroOrden = orderFilter.value.replace(/\D/g, '');
        orderFilter.value = filtroOrden;
        clearOrderFilter.classList.toggle('d-none', filtroOrden === '');
        renderVisibleQueue();
    }

    orderFilter.addEventListener('input', updateOrderFilter);
    clearOrderFilter.addEventListener('click', () => {
        orderFilter.value = '';
        updateOrderFilter();
        orderFilter.focus();
    });

    function inputCajaPrincipal() {
        return document.querySelector('.payment-account-input[data-account-type="CAJA"]');
    }

    function actualizarPago(inputModificado = null) {
        const row = document.getElementById(`row-${selectedPedido}`);
        if (!row) return;
        const total = parseFloat(row.dataset.total);

        // El efectivo es el saldo restante cuando se modifica una cuenta digital.
        // Así se conserva el flujo anterior: digital a la derecha, efectivo a la izquierda.
        if (inputModificado && inputModificado.dataset.accountType !== 'CAJA') {
            const totalDigital = [...document.querySelectorAll('.payment-account-input')]
                .filter(input => input.dataset.accountType !== 'CAJA')
                .reduce((sum, input) => sum + (parseFloat(input.value) || 0), 0);
            const caja = inputCajaPrincipal();
            if (caja) caja.value = Math.max(0, total - totalDigital).toFixed(2);
        }

        const distribuido = getDistribucion().reduce((sum, p) => sum + p.monto, 0);
        errorPago.classList.toggle('d-none', distribuido <= total + 0.01);
        errorPago.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i> La distribución supera el total de la factura.';

        // Mostrar/Ocultar sección de efectivo recibido
        const efectivo = montoCaja();
        if (efectivo <= 0) {
            wrapperRecibido.classList.add('d-none');
            inputRecibido.value = "";
        } else {
            wrapperRecibido.classList.remove('d-none');
        }
        
        calcularCambio();
    }

    function calcularCambio() {
        const efectivoARegistrar = montoCaja();
        const recibido = parseFloat(inputRecibido.value) || 0;

        if (recibido >= efectivoARegistrar && efectivoARegistrar > 0) {
            const cambio = recibido - efectivoARegistrar;
            displayCambio.innerText = fmt(cambio);
            containerCambio.classList.remove('d-none');
        } else {
            containerCambio.classList.add('d-none');
        }
    }

    inputRecibido.addEventListener('input', calcularCambio);
    
    // Botones de efectivo rápido
    const btnResetRecibido = document.getElementById('btn-reset-recibido');
    
    document.querySelectorAll('.quick-cash').forEach(btn => {
        btn.addEventListener('click', () => {
            const valorActual = parseFloat(inputRecibido.value) || 0;
            const valorBoton = parseFloat(btn.dataset.value);
            inputRecibido.value = valorActual + valorBoton;
            calcularCambio();
        });
    });

    btnResetRecibido.addEventListener('click', () => {
        inputRecibido.value = "";
        calcularCambio();
    });

    function updateWSStatus(text, colorClass) {
        const container = document.getElementById('sse-status-badge');
        if (container) container.innerHTML = `<span class="badge ${colorClass} animate-pulse">${text}</span>`;
    }

    window.facturarPedido = (id) => {
        const row = document.getElementById(`row-${id}`);
        const total = parseFloat(row.dataset.total);
        selectedPedido = id;

        document.getElementById('pago-total-display').innerText = fmt(total);
        document.querySelectorAll('.payment-account-input').forEach(input => input.value = '0');
        const caja = inputCajaPrincipal();
        if (caja) caja.value = total.toFixed(2);
        inputRecibido.value = "";
        // Por defecto se conserva el flujo anterior: facturar también imprime.
        // Se puede desactivar manualmente para facturar sin imprimir.
        document.getElementById('imprimir-factura').checked = true;
        errorPago.classList.add('d-none');
        containerCambio.classList.add('d-none');
        
        actualizarPago();
        
        const modalEl = document.getElementById('modalPago');
        let modal = bootstrap.Modal.getInstance(modalEl);
        if (!modal) {
            modal = new bootstrap.Modal(modalEl);
        }
        modal.show();
    };

    document.getElementById('btn-confirmar-pago').addEventListener('click', async () => {
        const pagos = getDistribucion();
        const total = parseFloat(document.getElementById(`row-${selectedPedido}`)?.dataset.total || 0);
        const distribuido = pagos.reduce((sum, p) => sum + p.monto, 0);
        const efectivo = montoCaja();
        const recibido = parseFloat(inputRecibido.value) || 0;
        const cambio = recibido > efectivo ? recibido - efectivo : 0;
        if (Math.abs(distribuido - total) > 0.01) {
            errorPago.classList.remove('d-none');
            return;
        }
        
        const btn = document.getElementById('btn-confirmar-pago');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> PROCESANDO...';

        try {
            const facturaResponse = await api.post(`/pedidos/${selectedPedido}/facturar`, { pagos });

            if (document.getElementById('imprimir-factura').checked) {
                try {
                    await api.post(`/pedidos/${selectedPedido}/imprimir-factura`, { recibido });
                } catch (printError) {
                    console.error('Factura generada, pero no se pudo imprimir:', printError);
                    await Swal.fire({
                        icon: 'warning',
                        title: 'Factura generada',
                        text: 'La factura quedó registrada, pero no se pudo enviar a la impresora.'
                    });
                }
            }
            
            const modalEl = document.getElementById('modalPago');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            if (efectivo > 0 && recibido > efectivo) {
                await Swal.fire({
                    title: '<span class="text-muted small uppercase fw-bold">CAMBIO A ENTREGAR</span>',
                    html: `<h1 class="display-1 fw-bold text-success mt-3">${fmt(cambio)}</h1>`,
                    icon: 'success',
                    confirmButtonText: 'ENTREGADO',
                    confirmButtonColor: '#10b981',
                    allowOutsideClick: true,
                    backdrop: `rgba(0,0,123,0.4)`
                });
            } else {
                Swal.fire({
                    icon: 'success',
                    title: 'Factura Generada',
                    timer: 1500,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });
            }

            // Facturar no termina la preparación: el pedido sigue visible en la cola.
            if (facturaResponse.pedido) updateOrderRow(facturaResponse.pedido);
        } catch (err) {
            console.error(err);
            Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo generar la factura.' });
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i> CONFIRMAR Y FACTURAR';
        }
    });

    cargarCuentasFacturacion().catch(error => console.error('No se pudieron cargar las cuentas de facturación:', error));

    window.actualizarDatoPedido = async (id, data) => {
        try {
            await api.patch(`/pedidos/${id}/actualizar-datos`, data);
            // No recargamos la fila aquí para evitar saltos si el usuario sigue editando,
            // el SSE se encargará de sincronizar si viene de otro cliente.
        } catch (err) {
            console.error("Error al actualizar pedido:", err);
            Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo actualizar el pedido.' });
        }
    };

    window.terminarPedido = async (id) => {
        const btn = document.getElementById(`btn-action-${id}`);
        if (!btn) return;
        btn.disabled = true;
        const originalText = btn.innerText;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        
        try {
            const res = await api.post(`/pedidos/${id}/terminar`);
            
            // 🟢 Notificación de Éxito
            Swal.fire({
                icon: 'success',
                title: '¡Pedido Terminado!',
                text: `El pedido #${id} está listo para entregar.`,
                timer: 1500,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });

            if (res.pedido) updateOrderRow(res.pedido);
        } catch (err) { 
            btn.disabled = false;
            btn.innerText = originalText;
            
            // 🔴 Notificación de Error
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: err.message || 'No se pudo terminar el pedido.'
            });
        }
    };

    window.entregarPedido = async (id) => {
        const btn = document.getElementById(`btn-action-${id}`);
        if (!btn) return;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        try {
            await api.post(`/pedidos/${id}/entregar`);
            removeOrderRow(id);
            Swal.fire({
                icon: 'success',
                title: 'Pedido entregado',
                timer: 1200,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        } catch (err) {
            btn.disabled = false;
            btn.innerText = 'ENTREGAR';
            Swal.fire({ icon: 'error', title: 'Error', text: err.message || 'No se pudo entregar el pedido.' });
        }
    };

    window.imprimirComanda = async (id) => {
        const result = await Swal.fire({
            title: '¿Imprimir comanda?',
            text: 'Se imprimirá la comanda de cocina y la copia con los datos del cliente.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Imprimir',
            cancelButtonText: 'Cancelar'
        });
        if (!result.isConfirmed) return;
        try {
            await api.post(`/pedidos/${id}/imprimir-comanda`, {});
        } catch (error) { console.error(error); }
    };

    window.eliminarPedido = async (id) => {
        const res = await Swal.fire({
            title: '¿Eliminar este pedido?',
            text: "El pedido se borrará permanentemente de la cola.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        });

        if (res.isConfirmed) {
            try {
                await api.delete(`/pedidos/${id}/eliminar`);
                removeOrderRow(id);
            } catch (err) {
                console.error(err);
            }
        }
    };

    async function init() {
        try {
            const pedidos = await api.get('/pedidos/pendientes');
            renderQueue(pedidos);
            initSSE();
        } catch (err) { 
            console.error("Error inicial:", err);
            Swal.fire({
                icon: 'error',
                title: 'Error de conexión',
                text: 'No se pudieron cargar los pedidos iniciales.'
            });
        }
    }

    function initSSE() {
        const mercure = new MercureClient();
        mercure.subscribe({
            topics: ['donwok/pedidos'],
            onOpen: () => {
            console.log("[SSE] Conectado ✅");
            updateWSStatus('Tiempo Real: Activo ✅', 'bg-success');
            },
            onMessage: (data) => {
            console.log("[SSE] Evento:", data);
            
            if (data.type === 'NEW_ORDER') {
                appendToQueue(data.pedido);
                const audio = new Audio('/vendor/notification.mp3');
                audio.play().catch(() => {});
            }
            else if (data.type === 'ORDER_READY' || data.type === 'ORDER_UPDATED') updateOrderRow(data.pedido);
            else if (data.type === 'ORDER_INVOICED') updateOrderRow(data.pedido);
            else if (data.type === 'ORDER_DELIVERED' || data.type === 'ORDER_DELETED') removeOrderRow(data.pedidoId ?? data.pedido?.id);
            },
            onError: () => {
            updateWSStatus('Reconectando...', 'bg-warning text-dark');
            },
        });
    }

    function renderQueue(pedidos) {
        pedidosEnCola = Array.isArray(pedidos) ? pedidos : [];
        renderVisibleQueue();
    }

    function renderVisibleQueue() {
        const body = document.getElementById('production-queue');
        const pedidos = pedidosEnCola.filter(p => !filtroOrden || String(p.id).includes(filtroOrden));
        if (pedidos.length === 0) {
            const message = pedidosEnCola.length === 0
                ? 'No hay pedidos pendientes'
                : `No hay pedidos para la orden #${filtroOrden}`;
            body.innerHTML = `<tr><td colspan="7" class="text-center py-5 text-muted">${message}</td></tr>`;
            return;
        }
        body.innerHTML = pedidos.map(p => rowTemplate(p)).join('');
    }

    function appendToQueue(pedido) {
        if (pedidosEnCola.some(p => p.id === pedido.id)) return;
        pedidosEnCola.push(pedido);
        renderVisibleQueue();
    }

    function updateOrderRow(pedido) {
        const index = pedidosEnCola.findIndex(p => p.id === pedido.id);
        if (index !== -1) {
            pedidosEnCola[index] = pedido;
            renderVisibleQueue();
        }
    }

    function removeOrderRow(id) {
        pedidosEnCola = pedidosEnCola.filter(p => p.id !== id);
        renderVisibleQueue();
    }

    function rowTemplate(p) {
        const items = p.items.map(i => `${i.cantidad}x ${i.producto}`).join(', ');
        const isPending = p.estado === 'PENDIENTE';
        const isBilled = Boolean(p.numeroFactura);
        const badgeClass = isPending ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success';
        const labelId = `<div class="order-number">ORDEN #${p.id}</div>`;

        const tipoSelect = `
            <select class="form-select form-select-sm border-0 bg-light fw-bold" onchange="window.actualizarDatoPedido(${p.id}, {tipo: this.value})">
                <option value="MESA" ${p.tipo === 'MESA' ? 'selected' : ''}>Mesa</option>
                <option value="LLEVAR" ${p.tipo === 'LLEVAR' ? 'selected' : ''}>Llevar</option>
                <option value="DOMICILIO" ${p.tipo === 'DOMICILIO' ? 'selected' : ''}>Dom.</option>
                <option value="WHATSAPP" ${p.tipo === 'WHATSAPP' ? 'selected' : ''}>Wsp</option>
            </select>
        `;

        const pagoLabel = p.numeroFactura
            ? '<span class="badge bg-success-subtle text-success border">PAGADO</span>'
            : '<span class="badge bg-secondary-subtle text-secondary border">PENDIENTE</span>';

        const terminarButton = isPending
            ? `<button id="btn-action-${p.id}" class="btn btn-primary btn-sm px-3 fw-bold" onclick="window.terminarPedido(${p.id})">TERMINAR</button>`
            : isBilled
                ? `<button id="btn-action-${p.id}" class="btn btn-warning btn-sm px-3 fw-bold" onclick="window.entregarPedido(${p.id})"><i class="bi bi-box-arrow-right me-1"></i>ENTREGAR</button>`
                : `<button id="btn-action-${p.id}" class="btn btn-outline-secondary btn-sm px-3 fw-bold" disabled title="Debe facturar e imprimir la factura antes de entregar"><i class="bi bi-lock me-1"></i>FACTURAR PRIMERO</button>`;
        const facturarButton = isBilled
            ? `<button class="btn btn-outline-secondary btn-sm px-3 fw-bold" disabled title="Factura ${p.numeroFactura}"><i class="bi bi-check-circle me-1"></i>FACTURADO</button>`
            : `<button class="btn btn-success btn-sm px-3 fw-bold" onclick="window.facturarPedido(${p.id})"><i class="bi bi-receipt me-1"></i>FACTURAR</button>`;
        const facturaLabel = isBilled
            ? `<small class="d-block text-success fw-bold mt-1">Factura ${p.numeroFactura}</small>`
            : '';
        const clienteLabel = p.clienteNombre
            ? `<small class="d-block text-muted mt-1"><i class="bi bi-person me-1"></i>${p.clienteNombre}</small>`
            : '';
        const domicilioLabel = p.tipo === 'DOMICILIO' && p.domicilioDescripcion
            ? `<small class="d-block text-primary mt-1" title="${p.domicilioDescripcion}"><i class="bi bi-geo-alt me-1"></i>${p.domicilioDescripcion}</small>`
            : '';
        const eliminarButton = isBilled
            ? ''
            : `<button class="btn btn-outline-danger btn-sm px-2 border-0" onclick="window.eliminarPedido(${p.id})" title="Eliminar Pedido"><i class="bi bi-trash"></i></button>`;

        return `
            <tr id="row-${p.id}" data-total="${p.total}">
                <td class="ps-4">${labelId}</td>
                <td class="small text-muted">${items}${clienteLabel}${domicilioLabel}</td>
                <td style="width: 120px;">${tipoSelect}</td>
                <td class="text-center">${pagoLabel}</td>
                <td class="text-center fw-bold text-dark">$${parseFloat(p.total).toLocaleString('es-CO')}</td>
                <td class="text-center">
                    <span class="badge ${badgeClass} border px-3 py-2" style="font-size: 0.7rem;">${p.estado}</span>
                    ${facturaLabel}
                </td>
                <td class="pe-4 text-end">
                    <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                        ${terminarButton}
                        ${facturarButton}
                        <button class="btn btn-outline-primary btn-sm px-2 fw-bold" onclick="window.imprimirComanda(${p.id})" title="Imprimir comanda y copia del cliente"><i class="bi bi-printer me-1"></i>COMANDA</button>
                    </div>
                    ${eliminarButton}
                </td>
            </tr>
        `;
    }

    init();
</script>
<style>
    .animate-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
    .order-number { font-size: 1.4rem; line-height: 1.1; font-weight: 800; color: var(--bs-primary); white-space: nowrap; }
</style>
{% endblock %}
