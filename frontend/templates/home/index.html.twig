{% extends 'base.html.twig' %}

{% block title %}DonWok | Inicio{% endblock %}
{% block body_class %}public-page{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);">
    <div class="container py-5">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8 text-white">
                <div class="bg-primary d-inline-flex p-3 rounded-4 shadow mb-4">
                    <i class="bi bi-shop-window display-6"></i>
                </div>
                <p class="text-info fw-bold text-uppercase mb-2" style="letter-spacing: .18em;">DonWok</p>
                <h1 class="display-3 fw-bold mb-3">Crece con nosotros</h1>
                <p class="lead text-white-50 mb-5">Conoce nuestras oportunidades de trabajo y administra tu negocio desde un solo lugar.</p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="/login" class="btn btn-light btn-lg px-5 fw-bold rounded-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                    </a>
                    <a href="/puestos-trabajo" class="btn btn-outline-light btn-lg px-5 fw-bold rounded-3">
                        <i class="bi bi-briefcase me-2"></i>Puesto de trabajo
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
