{% extends 'base.html.twig' %}

{% block title %}Inventario de Insumos - DonWok{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark">Inventario de Insumos</h2>
            <p class="text-muted mb-0">Control de cantidad y costo promedio</p>
        </div>
        <button class="dw-btn-primary text-white d-flex align-items-center gap-2 shadow-sm" onclick="openCreateModal()">
            <i class="bi bi-plus-lg"></i> NUEVO REGISTRO
        </button>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xl-4">
            <div class="dw-card p-3">
                <div class="text-muted small">Valor Total en Inventario</div>
                <div class="h4 fw-bold mb-0" id="totalInventario">$0</div>
            </div>
        </div>
    </div>

    <div class="dw-card shadow-sm overflow-hidden border-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="ps-4 py-3 text-muted small text-uppercase fw-bold">Insumo</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold text-center">Unidad</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold text-center">Cantidad</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold text-center">Costo Promedio</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold text-center">Valor Total</th>
                        <th class="pe-4 py-3 text-muted small text-uppercase fw-bold text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="inventoryTableBody">
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <div class="mt-2 text-muted">Cargando inventario...</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="container-fluid mt-4">
    <div class="dw-card shadow-sm overflow-hidden border-0">
        <div class="p-3 border-bottom">
            <h5 class="mb-0 fw-bold">Historial de Movimientos</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="ps-4 py-3 text-muted small text-uppercase fw-bold">Fecha</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold">Insumo</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold text-center">Tipo</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold text-center">Antes</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold text-center">Después</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold text-center">Δ</th>
                        <th class="py-3 text-muted small text-uppercase fw-bold text-center">Usuario</th>
                    </tr>
                </thead>
                <tbody id="historyTableBody">
                    <tr><td colspan="7" class="text-center py-4 text-muted">Sin movimientos aún.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Nuevo Registro de Inventario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createForm">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre (ej: Papa)</label>
                        <input type="text" id="nombre" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Unidad de Medida</label>
                        <select id="unidadMedida" class="form-select" required>
                            <option value="gramo">Gramo</option>
                            <option value="kilo">Kilo</option>
                            <option value="libra">Libra</option>
                            <option value="unidad">Unidad</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Cantidad</label>
                            <input type="number" step="0.01" min="0.01" id="cantidad" class="form-control" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Costo Total</label>
                            <input type="number" step="0.01" min="0" id="costo" class="form-control" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 p-4">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Actualizar Cantidad</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="updateForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="updateId">
                    <div class="mb-2 text-muted" id="updateNombre"></div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cantidad que queda (final)</label>
                        <input type="number" step="0.01" min="0.01" id="movCantidad" class="form-control" required>
                        <small class="text-muted">Sin costo, este valor representa lo que queda en inventario.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Costo Total (opcional, para ingreso)</label>
                        <input type="number" step="0.01" min="0" id="movCosto" class="form-control" placeholder="Déjalo vacío para descontar inventario">
                        <small class="text-muted">Si envías costo total, la cantidad se interpreta como cantidad nueva que ingresa.</small>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 p-4">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">Aplicar</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script type="module">
    import CoreAPI from '/js/core.js';
    const api = new CoreAPI();

    const currency = (value) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP' }).format(value || 0);

    function modal(id) {
        const el = document.getElementById(id);
        let m = bootstrap.Modal.getInstance(el);
        if (!m) m = new bootstrap.Modal(el);
        return m;
    }

    window.openCreateModal = () => {
        document.getElementById('createForm').reset();
        modal('createModal').show();
    };

    window.openUpdateModal = (id, nombre) => {
        document.getElementById('updateId').value = id;
        document.getElementById('updateNombre').innerText = `Insumo: ${nombre}`;
        document.getElementById('updateForm').reset();
        document.getElementById('updateId').value = id;
        modal('updateModal').show();
    };

    async function loadInventory() {
        try {
            const data = await api.get('/inventarios');
            document.getElementById('totalInventario').innerText = currency(data.totalInventario);
            renderRows(data.registros || []);
            loadHistory();
        } catch (err) {
            document.getElementById('inventoryTableBody').innerHTML = `<tr><td colspan="6" class="text-center py-5 text-danger">${err.message}</td></tr>`;
        }
    }

    function renderRows(items) {
        const body = document.getElementById('inventoryTableBody');
        if (!items.length) {
            body.innerHTML = '<tr><td colspan="6" class="text-center py-5">No hay registros de inventario.</td></tr>';
            return;
        }

        body.innerHTML = items.map(i => `
            <tr>
                <td class="ps-4">
                    <div class="fw-bold text-dark">${i.nombre}</div>
                    <small class="text-muted">ID: #${i.id}</small>
                </td>
                <td class="text-center">${i.unidadMedida}</td>
                <td class="text-center">${Number(i.cantidad).toFixed(2)}</td>
                <td class="text-center">${currency(i.costoPromedio)}</td>
                <td class="text-center fw-bold text-primary">${currency(i.valorTotalActual)}</td>
                <td class="pe-4 text-end">
                    <button class="btn btn-sm btn-outline-primary" onclick="openUpdateModal(${i.id}, '${i.nombre.replace(/'/g, "\\'")}')">
                        <i class="bi bi-arrow-repeat me-1"></i> Actualizar
                    </button>
                </td>
            </tr>
        `).join('');
    }

    async function loadHistory() {
        try {
            const rows = await api.get('/inventarios/historial');
            const body = document.getElementById('historyTableBody');
            if (!rows.length) {
                body.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Sin movimientos aún.</td></tr>';
                return;
            }

            body.innerHTML = rows.map(r => `
                <tr>
                    <td class="ps-4">${r.fecha || ''}</td>
                    <td>${r.inventarioNombre}</td>
                    <td class="text-center">${r.tipo}</td>
                    <td class="text-center">${Number(r.cantidadAnterior).toFixed(2)}</td>
                    <td class="text-center">${Number(r.cantidadNueva).toFixed(2)}</td>
                    <td class="text-center ${Number(r.cantidadDelta) < 0 ? 'text-danger' : 'text-success'}">${Number(r.cantidadDelta).toFixed(2)}</td>
                    <td class="text-center">${r.usuario}</td>
                </tr>
            `).join('');
        } catch (err) {
            document.getElementById('historyTableBody').innerHTML = '<tr><td colspan="7" class="text-center py-4 text-danger">No se pudo cargar historial.</td></tr>';
        }
    }

    document.getElementById('createForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
            nombre: document.getElementById('nombre').value,
            unidadMedida: document.getElementById('unidadMedida').value,
            cantidad: parseFloat(document.getElementById('cantidad').value),
            costo: parseFloat(document.getElementById('costo').value)
        };

        try {
            await api.post('/inventarios', payload);
            modal('createModal').hide();
            loadInventory();
        } catch (err) {}
    });

    document.getElementById('updateForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('updateId').value;
        const costoRaw = document.getElementById('movCosto').value;
        const payload = {
            cantidad: parseFloat(document.getElementById('movCantidad').value)
        };

        if (costoRaw !== '') payload.costo = parseFloat(costoRaw);

        try {
            await api.put(`/inventarios/${id}/actualizar-cantidad`, payload);
            modal('updateModal').hide();
            loadInventory();
        } catch (err) {}
    });

    loadInventory();
</script>
{% endblock %}
